{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(whoami:*)",
      "Bash(which:*)",
      "Bash(uv pip list:*)",
      "Bash(uv pip show:*)",
      "Bash(uv pip freeze:*)",
      "Bash(uv tree:*)",
      "Bash(uv python list:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git stash list:*)",
      "Bash(git blame:*)",
      "Bash(git tag:*)",
      "Bash(git ls-files:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh repo view:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Bash(obsidian:*)",
      "mcp__linear-server__get_attachment",
      "mcp__linear-server__list_comments",
      "mcp__linear-server__list_cycles",
      "mcp__linear-server__get_document",
      "mcp__linear-server__list_documents",
      "mcp__linear-server__extract_images",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__list_issues",
      "mcp__linear-server__list_issue_statuses",
      "mcp__linear-server__get_issue_status",
      "mcp__linear-server__list_issue_labels",
      "mcp__linear-server__list_projects",
      "mcp__linear-server__get_project",
      "mcp__linear-server__list_project_labels",
      "mcp__linear-server__list_milestones",
      "mcp__linear-server__get_milestone",
      "mcp__linear-server__list_teams",
      "mcp__linear-server__get_team",
      "mcp__linear-server__list_users",
      "mcp__linear-server__get_user",
      "mcp__linear-server__search_documentation",
      "mcp__linear-server__list_initiatives",
      "mcp__linear-server__get_initiative",
      "mcp__linear-server__get_status_updates"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(rm -rf*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(pkill*)",
      "Bash(killall*)",
      "Bash(kill -9*)",
      "Bash(curl*|*sh*)",
      "Bash(wget*|*sh*)",
      "Bash(git push *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(*--no-verify*)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform force-unlock *)",
      "Bash(terraform import *)",
      "Bash(terraform state rm *)",
      "Bash(terraform state mv *)",
      "Bash(terraform state push *)",
      "Bash(terraform workspace delete *)",
      "Bash(terraform workspace select prod*)",
      "Bash(terraform workspace select production*)",
      "Bash(sls deploy*--stage prod*)",
      "Bash(sls remove*--stage prod*)",
      "Bash(sls deploy*--stage production*)",
      "Bash(sls remove*--stage production*)",
      "Bash(serverless deploy*--stage prod*)",
      "Bash(serverless remove*--stage prod*)",
      "Bash(serverless deploy*--stage production*)",
      "Bash(serverless remove*--stage production*)",
      "Bash(docker run --privileged *)",
      "Bash(npm publish *)",
      "Bash(pip publish *)",
      "Bash(snow object drop *)",
      "Bash(snow stage drop *)",
      "Bash(snow stage remove *)",
      "Bash(snow stage execute *)",
      "Bash(snow app teardown *)",
      "Bash(snow app version drop *)",
      "Bash(snow spcs compute-pool drop *)",
      "Bash(snow spcs compute-pool stop-all *)",
      "Bash(snow spcs service drop *)",
      "Bash(snow snowpark drop *)",
      "Bash(obsidian eval:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo transfer:*)",
      "Bash(gh release delete:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh variable delete:*)",
      "Bash(gh run cancel:*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/approve-compound-bash.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/check-snow-sql.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {}
}
