{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Reloads the managed launch agents whenever their definitions change.
# Agents whose plist is not present on this machine (e.g. mcp-clickhouse
# where the env file is missing, see .chezmoiignore) are skipped.
# mcp-clickhouse hash: {{ include "private_Library/LaunchAgents/com.noaahh.mcp-clickhouse.plist.tmpl" | sha256sum }}
# dotfiles-drift hash: {{ include "private_Library/LaunchAgents/com.noaahh.dotfiles-drift.plist.tmpl" | sha256sum }}

set -euo pipefail

uid="$(id -u)"
for label in com.noaahh.mcp-clickhouse com.noaahh.dotfiles-drift; do
  plist="$HOME/Library/LaunchAgents/$label.plist"
  [ -f "$plist" ] || continue
  launchctl bootout "gui/$uid/$label" 2>/dev/null || true
  # bootout is asynchronous; an immediate bootstrap can race it with a
  # spurious "Input/output error", so retry briefly.
  for _ in 1 2 3 4 5; do
    launchctl bootstrap "gui/$uid" "$plist" 2>/dev/null && break
    sleep 1
  done
  launchctl print "gui/$uid/$label" >/dev/null 2>&1 || {
    echo "failed to load $label" >&2
    exit 1
  }
done
{{ end -}}
