{{- if lookPath "herdr" -}}
#!/bin/sh
# Rendered only when herdr is on PATH. Without the gate, a machine without
# herdr would record this run_onchange content as done and never install the
# plugins once herdr appears; an empty render records no state, so the script
# runs on the first apply after herdr shows up.

set -eu

# Plugin builds need the mise runtimes (shepherd builds with go); chezmoi
# runs this under sh, where .zshenv never loads the shims.
export PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH"

herdr plugin install jwarykowski/shepherd --yes
herdr plugin install jhochenbaum/herdr-hunk-diff --yes
herdr plugin install dmnkf/herdr-omnisearch --yes

if command -v jq >/dev/null 2>&1; then
    shepherd_root="$(herdr plugin list --json | jq -r '.result.plugins[] | select(.plugin_id == "jwarykowski.herdr-shepherd") | .plugin_root')"
    if [ -n "$shepherd_root" ]; then
        mkdir -p "$HOME/bin" "$HOME/.claude/skills"
        ln -sfn "$shepherd_root/bin/shepherd" "$HOME/bin/shepherd"
        ln -sfn "$shepherd_root/skills/shepherd" "$HOME/.claude/skills/shepherd"
    fi
fi

herdr plugin action invoke watch-start --plugin herdr.omnisearch >/dev/null 2>&1 || true

herdr server reload-config >/dev/null 2>&1 || true
{{ end -}}
