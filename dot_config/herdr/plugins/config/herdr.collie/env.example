# Reference for the real .env at:
#   $(herdr plugin config-dir herdr.collie)/.env
# This file is NOT read by Collie and is not applied over the real .env
# by chezmoi (different filename) - it just records what belongs there.
#
# Placeholder values only. The real address, tailnet name and contact
# address stay on the machine and are never committed to this public repo.
#
# VAPID keys are deliberately not tracked here either. Push subscriptions
# don't survive a machine move anyway, so on a new machine generate fresh
# ones from the plugin checkout and paste them into the real .env:
#   bunx web-push generate-vapid-keys
# See the collie plugin's own README ("Web Push" section) for details.

COLLIE_TRUSTED_USER=you@example.com
COLLIE_PUBLIC_HOSTS=<host>.<tailnet>.ts.net
COLLIE_VAPID_SUBJECT=mailto:you@example.com
# COLLIE_VAPID_PUBLIC=   # generate per machine - never commit
# COLLIE_VAPID_PRIVATE=  # generate per machine - never commit
