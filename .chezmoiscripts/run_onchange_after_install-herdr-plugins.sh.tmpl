{{- if lookPath "herdr" -}}
#!/bin/sh
# Rendered only when herdr is on PATH. Without the gate, a machine without
# herdr would record this run_onchange content as done and never install the
# plugins once herdr appears; an empty render records no state, so the script
# runs on the first apply after herdr shows up.

set -eu

# Plugin builds may need the mise runtimes; chezmoi runs this under sh,
# where .zshenv never loads the shims.
export PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH"

herdr plugin install dmnkf/herdr-omnisearch --yes
herdr plugin install jeffarese/herdr-bar --yes
# Local plugin, source lives in these dotfiles; relinking an existing link fails harmlessly.
herdr plugin link "$HOME/.config/herdr/plugins/local/noah.watch" >/dev/null 2>&1 || true
herdr plugin link "$HOME/.config/herdr/plugins/local/noah.tidy" >/dev/null 2>&1 || true

herdr plugin action invoke watch-start --plugin herdr.omnisearch >/dev/null 2>&1 || true

herdr server reload-config >/dev/null 2>&1 || true
{{ end -}}
