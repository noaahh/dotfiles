{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Keeps pinentry-mac from offering to save GPG passphrases in the login
# Keychain: a saved passphrase would let any process running as this user
# decrypt gopass secrets without a prompt. Restarts the agent so a changed
# gpg-agent.conf takes effect at once.
# gpg-agent.conf hash: {{ include "private_dot_gnupg/private_gpg-agent.conf" | sha256sum }}

set -euo pipefail

defaults write org.gpgtools.common DisableKeychain -bool yes
if command -v gpgconf >/dev/null 2>&1; then
  gpgconf --kill gpg-agent
fi
{{ end -}}
