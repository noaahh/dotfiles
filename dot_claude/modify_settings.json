{{- /* chezmoi:modify-template */ -}}
{{- /* Owns only the preference keys below; permissions, hooks, statusLine and
anything else Claude Code writes stay machine-local. The live file is passed
through untouched when these keys already match, so Claude Code's own
formatting does not show up as drift. */ -}}
{{- $managed := fromJson `{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "attribution": { "commit": "", "pr": "" },
  "model": "opus[1m]",
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "auto",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "remoteControlAtStartup": true,
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "ponytail@ponytail": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": { "source": { "source": "github", "repo": "cloudflare/skills" } },
    "i-have-adhd": { "source": { "source": "github", "repo": "ayghri/i-have-adhd" } },
    "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } },
    "openai-codex": { "source": { "source": "github", "repo": "openai/codex-plugin-cc" } }
  }
}` -}}
{{- $live := dict -}}
{{- if .chezmoi.stdin }}{{ $live = fromJson .chezmoi.stdin }}{{ end -}}
{{- $merged := mergeOverwrite (deepCopy $live) $managed -}}
{{- if and .chezmoi.stdin (eq (toJson $merged) (toJson $live)) -}}
{{- .chezmoi.stdin -}}
{{- else -}}
{{- toPrettyJson $merged }}
{{ end -}}
